# The bash launcher must keep LF endings or it will not run on macOS or Linux
# after a checkout on Windows.
scripts/siteseo text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf

# Vendored files are pinned by content hash in upstream.lock. Git must not
# rewrite their line endings, or the hash stops matching on a checkout whose
# platform convention differs from the one that computed it.
vendor/** -text

# Handler templates are rendered into site repos; keep them byte-stable.
skills/siteseo/templates/** text eol=lf
