#!/usr/bin/env bash
# Stable entry point for every bundled siteseo tool.
#
# Skills, agents, hooks and CI call this as
#   "${CLAUDE_PLUGIN_ROOT}/scripts/siteseo" run <script.py> [args...]
# and never invoke a bare interpreter. The launcher uses only shell built-ins
# until it has identified a usable bootstrap Python, then hands off to cli.py,
# which resolves the isolated environment that actually holds the dependencies.
#
# The bootstrap Python only has to exist and be 3.11+. It is not where packages
# are installed. See scripts/runtime.py.
#
# Launcher discovery approach adapted from AgriciDaniel/claude-seo (MIT).
# It lives in scripts/ rather than bin/ because hosted marketplaces reject a
# plugin that ships a top-level bin/ directory.

set -euo pipefail

launcher_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
cli="${launcher_dir}/cli.py"

if [[ ! -f "${cli}" ]]; then
    echo "siteseo is missing scripts/cli.py. Reinstall the plugin." >&2
    exit 2
fi

version_ok='import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'

# An override is an executable path, not a shell command. Keeping it as a single
# argument prevents command injection and supports paths containing spaces.
if [[ -n "${SITESEO_PYTHON:-}" ]]; then
    if "${SITESEO_PYTHON}" -c "${version_ok}" >/dev/null 2>&1; then
        exec "${SITESEO_PYTHON}" "${cli}" "$@"
    fi
    echo "SITESEO_PYTHON is not a usable Python 3.11+ executable." >&2
    exit 2
fi

# Windows launcher first: `py -3` resolves the newest install without PATH games.
if command -v py >/dev/null 2>&1 && py -3 -c "${version_ok}" >/dev/null 2>&1; then
    exec py -3 "${cli}" "$@"
fi

for candidate in python3.13 python3.12 python3.11 python3 python; do
    if command -v "${candidate}" >/dev/null 2>&1 \
        && "${candidate}" -c "${version_ok}" >/dev/null 2>&1; then
        exec "${candidate}" "${cli}" "$@"
    fi
done

cat >&2 <<'MSG'
siteseo needs Python 3.11 or newer on PATH to bootstrap.

  macOS    brew install python@3.12
  Windows  winget install Python.Python.3.12
  Linux    use your distribution's python3.12 package

Already installed somewhere unusual? Point siteseo at it:
  export SITESEO_PYTHON=/full/path/to/python
MSG
exit 2
